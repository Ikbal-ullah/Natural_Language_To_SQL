# Owner/DDL connection (migrations, seeding, index builds)
NL2SQL_ADMIN_DSN=postgresql://localhost:5432/nl2sql
# Read-only connection used to execute every generated query (defence in depth)
NL2SQL_READONLY_DSN=postgresql://nl2sql_ro@localhost:5432/nl2sql
# Hard cap enforced by PostgreSQL, not by the prompt
NL2SQL_STATEMENT_TIMEOUT_MS=5000
# Plan gate thresholds
NL2SQL_MAX_PLAN_COST=5000000
NL2SQL_LARGE_TABLE_ROWS=100000
NL2SQL_MAX_LIMIT=1000
NL2SQL_MAX_RETRIES=2
# LLM
ANTHROPIC_API_KEY=
NL2SQL_MODEL=claude-opus-5
